# Postgres (Aiven or any Postgres) — used by src/lib/db/postgres.ts + scripts/migrate.ts
# Paste your connection string WITHOUT ?sslmode= (SSL is configured in code for self-signed CAs)
DATABASE_URL=postgres://user:password@host:port/dbname

# Supabase (optional — enables auth when real values are set; placeholders keep demo mode)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cloudflare R2
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key
R2_BUCKET=your-bucket-name
NEXT_PUBLIC_R2_URL=https://your-bucket.your-r2-domain.com

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
